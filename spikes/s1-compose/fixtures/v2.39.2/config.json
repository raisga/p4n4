{
  "name": "p4n4s1-main",
  "networks": {
    "default": {
      "name": "p4n4-net",
      "ipam": {
        "config": [
          {
            "subnet": "10.201.1.0/24",
            "ip_range": "10.201.1.128/25"
          }
        ]
      }
    }
  },
  "services": {
    "agent": {
      "profiles": [
        "agent"
      ],
      "command": [
        "sh",
        "-c",
        "trap 'exit 0' TERM; while :; do sleep 1; done"
      ],
      "container_name": "p4n4s1-agent",
      "depends_on": {
        "mqtt": {
          "condition": "service_started",
          "required": false
        },
        "server": {
          "condition": "service_healthy",
          "required": false
        }
      },
      "entrypoint": null,
      "environment": {
        "MQTT_HOST": "mqtt"
      },
      "image": "alpine:3.20",
      "networks": {
        "default": null
      }
    },
    "mqtt": {
      "profiles": [
        "mqtt"
      ],
      "command": [
        "sh",
        "-c",
        "mkdir -p /www \u0026\u0026 echo ok \u003e /www/index.html \u0026\u0026 exec httpd -f -p 1883 -h /www"
      ],
      "container_name": "p4n4s1-mqtt",
      "entrypoint": null,
      "image": "busybox:1.36",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 1883,
          "published": "18101",
          "protocol": "tcp"
        }
      ]
    },
    "server": {
      "command": [
        "sh",
        "-c",
        "mkdir -p /www \u0026\u0026 echo ok \u003e /www/index.html \u0026\u0026 exec httpd -f -p 8080 -h /www"
      ],
      "container_name": "p4n4s1-server",
      "entrypoint": null,
      "environment": {
        "P4N4S1_MSG": "from-root-env"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1:8080/"
        ],
        "timeout": "2s",
        "interval": "2s",
        "retries": 15
      },
      "image": "busybox:1.36",
      "networks": {
        "default": {
          "ipv4_address": "10.201.1.2"
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "18100",
          "protocol": "tcp"
        }
      ]
    }
  }
}